# You usually do not need this file. Run `mongosh-llm setup` and the CLI will ask a few questions
# and save the answers for you. Use a .env only if you prefer to configure things by hand or in CI.

# --- Where queries actually run ---
# local   (default) queries run on this machine via mongosh, using MONGODB_URI below
# backend queries run on a backend that holds the connection string, so you never need one
# EXECUTION_MODE=local

# MongoDB connection string. Required for EXECUTION_MODE=local, ignored for backend.
MONGODB_URI=mongodb://localhost:27017/sample_mflix

# --- Choose ONE way for the CLI to reach an LLM ---
# Optional: force a specific provider instead of relying on inference below
# LLM_PROVIDER=anthropic | backend | ollama

# Option A: Direct mode - call Anthropic's API with your own key
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Option B: Backend mode - point the CLI at a self-hosted backend instead
# BACKEND_URL=http://localhost:3000
# BACKEND_API_KEY=

# Option C: Local mode - run a model yourself via Ollama (free, private, less reliable than Claude)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral-nemo

# Safety: "safe" (default, read-only) or "unsafe" (allows write operations, asks for confirmation)
QUERY_MODE=safe
