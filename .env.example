# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/sample_mflix

# --- Choose ONE way for the CLI to reach an LLM ---
# Optional: force a specific provider instead of relying on inference below
# LLM_PROVIDER=anthropic | backend | ollama

# Option A: Direct mode - call Anthropic's API with your own key
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Option B: Backend mode - point the CLI at a self-hosted backend instead
# BACKEND_URL=http://localhost:3000

# Option C: Local mode - run a model yourself via Ollama (free, private, less reliable than Claude)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral-nemo

# Safety: "safe" (default, read-only) or "unsafe" (allows write operations, asks for confirmation)
QUERY_MODE=safe
