# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/sample_mflix

# --- Choose ONE way for the CLI to reach Claude ---

# Option A: Direct mode - call Anthropic's API with your own key
ANTHROPIC_API_KEY=

# Option B: Backend mode - point the CLI at a self-hosted backend instead
# BACKEND_URL=http://localhost:3000

# Optional: override the Claude model id
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Safety: "safe" (default, read-only) or "unsafe" (allows write operations, asks for confirmation)
QUERY_MODE=safe
